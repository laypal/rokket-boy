{
  "name": "team-rokket",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TEAM ROKKET — Rise of the Rocket. Game Boy-style heist RPG, single-HTML build.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/postbuild.mjs",
    "build:staging": "npm run typecheck && vite build --mode staging && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "mirror:public": "node scripts/mirror/publish.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "test:e2e:dist": "playwright test --config playwright.dist.config.ts",
    "sprite": "node scripts/sprite-io.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.6.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
